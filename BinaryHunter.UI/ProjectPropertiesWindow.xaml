<Window x:Class="BinaryHunter.UI.ProjectPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project properties" Width="760" Height="610" MinWidth="620" MinHeight="460"
        Background="#0D1117" Foreground="#EDF2F7" FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="PROJECT INFORMATION" FontSize="{StaticResource PageTitleFontSize}" FontWeight="SemiBold"/>
            <TextBlock x:Name="ProjectPathText" Margin="0,4,0,12" Foreground="#AAB4C0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <TabControl x:Name="PropertiesTabs" Grid.Row="1">
            <TabItem Header="GENERAL">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="PROJECT NAME" Foreground="#AAB4C0" VerticalAlignment="Center"/>
                    <TextBox x:Name="ProjectNameTextBox" Grid.Column="1" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="1" Text="PROJECT ID" Foreground="#AAB4C0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ProjectIdText" Grid.Row="1" Grid.Column="1" Margin="0,7,0,10"/>
                    <TextBlock Grid.Row="2" Text="CREATED" Foreground="#AAB4C0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CreatedText" Grid.Row="2" Grid.Column="1" Margin="0,7,0,10"/>
                    <TextBlock Grid.Row="3" Text="UPDATED" Foreground="#AAB4C0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="UpdatedText" Grid.Row="3" Grid.Column="1" Margin="0,7,0,10"/>
                    <TextBlock Grid.Row="4" Text="SOURCES" Foreground="#AAB4C0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SourcesText" Grid.Row="4" Grid.Column="1" Margin="0,7,0,10"/>
                    <TextBlock Grid.Row="5" Text="VERSIONS" Foreground="#AAB4C0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="VersionsText" Grid.Row="5" Grid.Column="1" Margin="0,7,0,0"/>
                </Grid>
            </TabItem>
            <TabItem Header="COMMENT">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Project notes, calibration purpose, vehicle information and change instructions"
                               Foreground="#AAB4C0" Margin="0,0,0,9" TextWrapping="Wrap"/>
                    <TextBox x:Name="ProjectCommentTextBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="12"/>
                </Grid>
            </TabItem>
            <TabItem Header="ACTIVE VERSION">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="VERSION NAME" Foreground="#AAB4C0" VerticalAlignment="Center"/>
                    <TextBox x:Name="VersionNameTextBox" Grid.Column="1" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="1" Text="SHA-256" Foreground="#AAB4C0" VerticalAlignment="Center"/>
                    <TextBox x:Name="VersionHashTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" IsReadOnly="True"/>
                    <TextBlock Grid.Row="2" Text="VERSION COMMENT" Foreground="#AAB4C0" VerticalAlignment="Top" Margin="0,7,0,0"/>
                    <TextBox x:Name="VersionCommentTextBox" Grid.Row="2" Grid.Column="1" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                </Grid>
            </TabItem>
            <TabItem Header="METADATA">
                <DataGrid x:Name="MetadataGrid" Margin="12" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          Background="#10151D" Foreground="#EDF2F7" BorderBrush="#2B3441">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="KEY" Binding="{Binding Key}" Width="230"/>
                        <DataGridTextColumn Header="VALUE" Binding="{Binding Value}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="HISTORY">
                <DataGrid x:Name="HistoryGrid" Margin="12" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          Background="#10151D" Foreground="#EDF2F7" BorderBrush="#2B3441">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DATE" Binding="{Binding TimestampUtc, StringFormat=g}" Width="145"/>
                        <DataGridTextColumn Header="EVENT" Binding="{Binding Title}" Width="180"/>
                        <DataGridTextColumn Header="DETAILS" Binding="{Binding Details}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Foreground="#AAB4C0" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="SAVE" Margin="6,0" Click="SaveButton_Click"/>
            <Button Grid.Column="2" Content="CLOSE" Margin="6,0,0,0" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
