<Window x:Class="BinaryHunter.UI.DifferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Differences to reference" Width="1040" Height="650" MinWidth="760" MinHeight="440"
        Background="#0D1117" Foreground="#EDF2F7" FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="DIFFERENCES TO REFERENCE" FontSize="{StaticResource PageTitleFontSize}" FontWeight="SemiBold"/>
                <TextBlock x:Name="SourceText" Margin="0,4,0,0" Foreground="#AAB4C0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#29191F" BorderBrush="#62343C" BorderThickness="1" Padding="14,8">
                <TextBlock x:Name="SummaryText" Foreground="#AFCBFF" FontWeight="SemiBold"/>
            </Border>
        </Grid>
        <Grid Grid.Row="1" Margin="0,14,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="145"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="FROM OFFSET" VerticalAlignment="Center" Foreground="#AAB4C0"/>
            <TextBox x:Name="FromTextBox" Grid.Column="1" Margin="8,0,16,0" Text="0x0"/>
            <TextBlock Grid.Column="2" Text="ROW LIMIT" VerticalAlignment="Center" Foreground="#AAB4C0"/>
            <ComboBox x:Name="LimitComboBox" Grid.Column="3" Margin="8,0,16,0" SelectedIndex="1">
                <ComboBoxItem Content="1,000" Tag="1000"/><ComboBoxItem Content="5,000" Tag="5000"/><ComboBoxItem Content="20,000" Tag="20000"/><ComboBoxItem Content="100,000" Tag="100000"/>
            </ComboBox>
            <Button Grid.Column="5" Content="REFRESH" Click="RefreshButton_Click"/>
        </Grid>
        <TabControl Grid.Row="2">
            <TabItem Header="BYTE DIFFERENCES">
                <DataGrid x:Name="DifferencesGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow" Background="#10151D" Foreground="#EDF2F7"
                          BorderBrush="#2B3441" GridLinesVisibility="Horizontal" RowBackground="#10151D" AlternatingRowBackground="#161C25"
                          MouseDoubleClick="DifferencesGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="65"/>
                        <DataGridTextColumn Header="HEX OFFSET" Binding="{Binding HexOffset}" Width="125"/>
                        <DataGridTextColumn Header="REF" Binding="{Binding ReferenceHex}" Width="70"/>
                        <DataGridTextColumn Header="CURRENT" Binding="{Binding CurrentHex}" Width="85"/>
                        <DataGridTextColumn Header="DELTA" Binding="{Binding DeltaText}" Width="75"/>
                        <DataGridTextColumn Header="%" Binding="{Binding PercentText}" Width="85"/>
                        <DataGridTextColumn Header="SCOPE" Binding="{Binding Scope}" Width="90"/>
                        <DataGridTextColumn Header="MAP" Binding="{Binding MapName}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="CHANGED MAPS">
                <DataGrid ItemsSource="{Binding Maps}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="#10151D" Foreground="#EDF2F7" BorderBrush="#2B3441">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="MAP" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="180"/>
                        <DataGridTextColumn Header="OFFSET" Binding="{Binding HexOffset}" Width="130"/>
                        <DataGridTextColumn Header="SIZE" Binding="{Binding Size}" Width="90"/>
                        <DataGridTextColumn Header="CHANGED" Binding="{Binding ChangedBytes}" Width="100"/>
                        <DataGridTextColumn Header="%" Binding="{Binding ChangedPercent}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#AAB4C0"/>
            <Button Grid.Column="1" Content="GO TO" Margin="6,0" Click="GoToButton_Click"/>
            <Button Grid.Column="2" Content="RESTORE REF" Margin="6,0" Click="RestoreButton_Click"/>
            <Button Grid.Column="3" Content="EXPORT" Margin="6,0" Click="ExportButton_Click"/>
            <Button Grid.Column="4" Content="CLOSE" Margin="6,0,0,0" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
