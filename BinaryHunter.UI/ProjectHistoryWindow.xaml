<Window x:Class="BinaryHunter.UI.ProjectHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project History" Icon="Assets/BinaryHunter.ico"
        Width="940" Height="650" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#0D1117" Foreground="#EDF2F7"
        FontFamily="{StaticResource UiFont}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#141418" BorderBrush="#34445A" BorderThickness="1" Padding="14,10" CornerRadius="2">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="#4C8DFF" Margin="-14,-10,0,-10"/>
                <StackPanel Grid.Column="1" Margin="11,0,0,0">
                    <TextBlock x:Name="ProjectNameText" FontSize="{StaticResource SectionFontSize}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ProjectPathText" Margin="0,3,0,0" Foreground="#778391"
                               FontSize="{StaticResource CaptionFontSize}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="PROJECT VERSIONS" Foreground="#AFCBFF" FontSize="{StaticResource CaptionFontSize}" FontWeight="SemiBold" Margin="1,0,0,6"/>
            <DataGrid x:Name="VersionsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" MouseDoubleClick="VersionsGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Number, StringFormat=D4}" Width="60"/>
                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="180"/>
                    <DataGridTextColumn Header="CREATED" Binding="{Binding CreatedUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="155"/>
                    <DataGridTextColumn Header="SIZE" Binding="{Binding Size, StringFormat={}{0:N0} bytes}" Width="130"/>
                    <DataGridTextColumn Header="COMMENT" Binding="{Binding Comment}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="PROJECT HISTORY" Foreground="#AFCBFF" FontSize="{StaticResource CaptionFontSize}" FontWeight="SemiBold" Margin="1,0,0,6"/>
            <DataGrid x:Name="HistoryGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TIME" Binding="{Binding TimestampUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="155"/>
                    <DataGridTextColumn Header="EVENT" Binding="{Binding Kind}" Width="130"/>
                    <DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="190"/>
                    <DataGridTextColumn Header="DETAILS" Binding="{Binding Details}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Row="6">
            <TextBlock x:Name="SummaryText" Foreground="#778391" FontSize="{StaticResource CaptionFontSize}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OPEN SELECTED VERSION" Padding="12,6" Click="OpenVersionButton_Click"/>
                <Button Content="CLOSE" Padding="12,6" Margin="7,0,0,0" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>