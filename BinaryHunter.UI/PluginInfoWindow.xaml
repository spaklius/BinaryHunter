<Window x:Class="BinaryHunter.UI.PluginInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Installed plugins" Icon="Assets/BinaryHunter.ico" Width="900" Height="560"
        MinWidth="720" MinHeight="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#0D1117" Foreground="#EDF2F7" FontFamily="{StaticResource UiFont}">
    <Window.Resources><Style TargetType="Button" BasedOn="{StaticResource FuturisticButton}"><Setter Property="Padding" Value="13,7"/><Setter Property="Margin" Value="4,0"/></Style></Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12"><TextBlock Text="PLUGIN INFORMATION" Foreground="#60A5FA" FontWeight="SemiBold" FontSize="{StaticResource MetadataFontSize}"/><TextBlock Text="Built-in modules and compatible DLL plugins discovered in the application Plugins directory." Foreground="#778391" FontSize="{StaticResource MetadataFontSize}" Margin="0,5,0,0"/></StackPanel>
        <DataGrid x:Name="PluginsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  Background="#10151D" Foreground="#EDF2F7" BorderBrush="#2B3441" RowBackground="#10151D" AlternatingRowBackground="#1B222D" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="210"/>
                <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="135"/>
                <DataGridTextColumn Header="VERSION" Binding="{Binding Version}" Width="80"/>
                <DataGridTextColumn Header="AUTHOR" Binding="{Binding Author}" Width="110"/>
                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="80"/>
                <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="120"/>
                <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="2" Margin="0,14,0,0"><TextBlock x:Name="StatusText" Foreground="#AAB4C0" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="REFRESH" Click="RefreshButton_Click"/><Button Content="CLOSE" Click="CloseButton_Click"/></StackPanel></Grid>
    </Grid>
</Window>
