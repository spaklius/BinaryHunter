<Window x:Class="BinaryHunter.UI.NumericConversionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scaling / Formula" Icon="Assets/BinaryHunter.ico"
        Width="610" Height="430" MinWidth="540" MinHeight="390"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#0D1117" Foreground="#EDF2F7" FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0D1117"/><Setter Property="Foreground" Value="#EDF2F7"/>
            <Setter Property="BorderBrush" Value="#3B4655"/><Setter Property="Padding" Value="9,6"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource FuturisticButton}">
            <Setter Property="Padding" Value="13,7"/><Setter Property="Margin" Value="4,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="NUMERIC CONVERSION" Foreground="#6BA1FF" FontWeight="SemiBold" FontSize="{StaticResource MetadataFontSize}"/>
            <TextBlock Margin="0,5,0,0" Foreground="#AAB4C0" FontSize="{StaticResource MetadataFontSize}" TextWrapping="Wrap"
                       Text="Result = formula(x) × factor + offset. Formula x is the decoded raw value."/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Factor" VerticalAlignment="Center" Foreground="#AAB4C0"/>
            <TextBox x:Name="FactorTextBox" Grid.Column="1" TextChanged="Input_TextChanged"/>
            <TextBlock Grid.Column="2" Text="Offset" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#AAB4C0"/>
            <TextBox x:Name="OffsetTextBox" Grid.Column="3" TextChanged="Input_TextChanged"/>
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Formula" VerticalAlignment="Center" Foreground="#AAB4C0"/>
            <TextBox x:Name="FormulaTextBox" Grid.Column="1" TextChanged="Input_TextChanged"/>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Unit" VerticalAlignment="Center" Foreground="#AAB4C0"/>
            <TextBox x:Name="UnitTextBox" Grid.Column="1" ToolTip="Examples: bar, kPa, rpm, mg/stroke, %, °C"/>
        </Grid>
        <Border Grid.Row="4" Background="#161C25" BorderBrush="#2B3441" BorderThickness="1" Padding="12">
            <StackPanel>
                <TextBlock x:Name="PreviewText" Foreground="#60A5FA" FontSize="{StaticResource MetadataFontSize}"/>
                <TextBlock x:Name="ValidationText" Foreground="#6BA1FF" FontSize="{StaticResource MetadataFontSize}" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="5" Margin="0,14,0,0" Foreground="#85858E" FontSize="{StaticResource MetadataFontSize}" TextWrapping="Wrap"
                   Text="Examples: x * 0.023438; x / 10; x - 32768; max(0, x). Display profile does not change the file. Transform selection writes converted values back using the active data type and endian setting."/>
        <DockPanel Grid.Row="6" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="Cancel" Click="CancelButton_Click"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Apply display profile" Background="#1D4ED8" BorderBrush="#60A5FA" Click="DisplayButton_Click"/>
                <Button Content="Transform selection" Background="#4C8DFF" BorderBrush="#6BA1FF" Click="TransformButton_Click"/>
                <Button Content="Reset" Click="ResetButton_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
