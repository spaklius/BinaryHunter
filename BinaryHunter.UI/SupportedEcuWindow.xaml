<Window x:Class="BinaryHunter.UI.SupportedEcuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Supported ECU Profiles" Icon="Assets/BinaryHunter.ico"
        Width="920" Height="720" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Background="{StaticResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="20,14">
            <StackPanel>
                <TextBlock Text="Supported ECU profiles" Style="{StaticResource WindowTitleTextStyle}"/>
                <TextBlock x:Name="ProfileCountText" Style="{StaticResource SecondaryTextStyle}" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource SurfaceRaisedBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="FilterTextBox" Padding="10,6,34,6"
                             TextChanged="FilterTextBox_TextChanged"
                             ToolTip="Filter by ECU family, manufacturer or profile"/>
                    <TextBlock Text="Filter ECU families and profiles…"
                               Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatusTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=FilterTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <CheckBox x:Name="HideBaseCheckBox" Grid.Column="1" Content="Hide BASE detectors"
                          Margin="16,0,0,0" VerticalAlignment="Center"
                          Checked="FilterCheckBox_Changed" Unchecked="FilterCheckBox_Changed"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="GroupsControl" Margin="20,14,12,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander IsExpanded="True" Margin="0,0,0,10">
                            <Expander.Header>
                                <Grid MinWidth="600" Margin="2,2,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding VehicleBrand}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat={}{0} profiles}"
                                               Style="{StaticResource MetadataTextStyle}" Margin="12,0,0,0"/>
                                </Grid>
                            </Expander.Header>
                            <Border Background="{StaticResource WorkspaceBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <ItemsControl ItemsSource="{Binding Profiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="42" Margin="12,0" Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="72"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDraft}" Value="True">
                                                                        <Setter Property="Text" Value="{Binding Name, StringFormat={}{0} (BASE)}"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding ImageSize}"
                                                           Style="{StaticResource MetadataTextStyle}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="FULL" Foreground="{StaticResource SuccessBrush}"
                                                           Style="{StaticResource TechnicalLabelTextStyle}" VerticalAlignment="Center"
                                                           Visibility="{Binding SupportsFull, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Grid.Column="3" Text="PARTIAL" Foreground="{StaticResource WarningBrush}"
                                                           Style="{StaticResource TechnicalLabelTextStyle}" VerticalAlignment="Center"
                                                           Visibility="{Binding SupportsPartial, Converter={StaticResource BoolToVis}}"/>
                                                <Border Grid.ColumnSpan="4" BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="0,0,0,1" IsHitTestVisible="False"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <TextBlock Text="Profiles are generated from the registered detector catalog."
                           Style="{StaticResource StatusTextStyle}" VerticalAlignment="Center"/>
                <Button Content="Close" HorizontalAlignment="Right" Click="CloseButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
