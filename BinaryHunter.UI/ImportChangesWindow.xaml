<Window x:Class="BinaryHunter.UI.ImportChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import changes" Width="1060" Height="690" MinWidth="820" MinHeight="520"
        Background="#0D1117" Foreground="#EDF2F7" FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="IMPORT CHANGES" FontSize="{StaticResource PageTitleFontSize}" FontWeight="SemiBold"/>
                <TextBlock Text="Relocate maps and transfer calibration changes between firmware versions"
                           Margin="0,4,0,0" Foreground="#AAB4C0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#4C8DFF" Padding="10,6"><TextBlock Text="1  SOURCE" FontWeight="SemiBold"/></Border>
                <Border Background="#2B3441" Padding="10,6" Margin="4,0"><TextBlock Text="2  MATCH"/></Border>
                <Border Background="#2B3441" Padding="10,6"><TextBlock Text="3  TRANSFER"/></Border>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,15,0,9">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="SOURCE PROJECT" VerticalAlignment="Center" Foreground="#AAB4C0"/>
            <TextBox x:Name="SourceProjectTextBox" Grid.Column="1" Margin="10,0" IsReadOnly="True"/>
            <Button Grid.Column="2" Content="CHOOSE PROJECT" Click="ChooseSourceButton_Click"/>
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="MATCH TOLERANCE %" VerticalAlignment="Center" Foreground="#AAB4C0"/>
            <TextBox x:Name="ToleranceTextBox" Grid.Column="1" Text="5" Margin="8,0,18,0" TextAlignment="Center"/>
            <CheckBox x:Name="ChangedOnlyCheckBox" Grid.Column="2" Content="Changed maps only" IsChecked="True" VerticalAlignment="Center"/>
            <Button Grid.Column="3" Content="ANALYZE" Margin="14,0,0,0" Click="AnalyzeButton_Click"/>
            <Button Grid.Column="5" Content="SELECT READY" Margin="6,0" Click="SelectReadyButton_Click"/>
            <Button Grid.Column="6" Content="CLEAR" Margin="6,0,0,0" Click="ClearSelectionButton_Click"/>
        </Grid>
        <DataGrid x:Name="CandidatesGrid" Grid.Row="3" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                  CanUserAddRows="False" SelectionMode="Extended" Background="#10151D" Foreground="#EDF2F7"
                  BorderBrush="#2B3441" GridLinesVisibility="Horizontal" RowBackground="#10151D" AlternatingRowBackground="#161C25">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="USE" Binding="{Binding IsSelected}" Width="55"/>
                <DataGridTextColumn Header="MAP" Binding="{Binding Candidate.SourceMap.Name}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="SOURCE" Binding="{Binding Candidate.SourceAddress}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="TARGET" Binding="{Binding Candidate.TargetAddress}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="SIZE" Binding="{Binding Candidate.Dimensions}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="MATCH" Binding="{Binding Candidate.MatchMethod}" Width="145" IsReadOnly="True"/>
                <DataGridTextColumn Header="CONF." Binding="{Binding Candidate.ConfidenceText}" Width="75" IsReadOnly="True"/>
                <DataGridCheckBoxColumn Header="CHANGED" Binding="{Binding Candidate.SourceChanged}" Width="80" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="StatusText" Foreground="#AAB4C0"/>
                <TextBlock x:Name="SourceInfoText" Margin="0,3,0,0" Foreground="#71717A" FontSize="{StaticResource CaptionFontSize}"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="TRANSFER MODE" VerticalAlignment="Center" Foreground="#AAB4C0"/>
            <ComboBox x:Name="TransferModeComboBox" Grid.Column="2" Margin="8,0,12,0" SelectedIndex="2">
                <ComboBoxItem Content="Definitions only" Tag="DefinitionsOnly"/>
                <ComboBoxItem Content="Absolute values" Tag="AbsoluteValues"/>
                <ComboBoxItem Content="Relative changes" Tag="RelativeChanges"/>
            </ComboBox>
            <StackPanel Grid.Column="3" Margin="0,0,12,0" VerticalAlignment="Center">
                <CheckBox x:Name="ImportDefinitionsCheckBox" Content="Import map definitions" IsChecked="True"/>
                <CheckBox x:Name="SkipChecksumsCheckBox" Content="Skip checksum storage" IsChecked="True" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="4" Content="APPLY" Margin="6,0" Click="ApplyButton_Click"/>
            <Button Grid.Column="5" Content="CANCEL" Margin="6,0,0,0" Click="CancelButton_Click"/>
        </Grid>
    </Grid>
</Window>
