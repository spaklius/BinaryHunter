<Window x:Class="BinaryHunter.UI.DataProcessingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smooth / Interpolate" Icon="Assets/BinaryHunter.ico" Width="680" Height="510"
        MinWidth="590" MinHeight="440" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#0D1117" Foreground="#EDF2F7" FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <Style TargetType="ComboBox" BasedOn="{StaticResource FuturisticComboBox}"/>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#0D1117"/><Setter Property="Foreground" Value="#EDF2F7"/><Setter Property="BorderBrush" Value="#3B4655"/><Setter Property="Padding" Value="8,6"/></Style>
        <Style TargetType="Button" BasedOn="{StaticResource FuturisticButton}"><Setter Property="Padding" Value="13,7"/><Setter Property="Margin" Value="4,0"/></Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16"><TextBlock Text="2D DATA PROCESSING" Foreground="#6BA1FF" FontWeight="SemiBold" FontSize="{StaticResource MetadataFontSize}"/><TextBlock x:Name="ScopeText" Foreground="#778391" FontSize="{StaticResource MetadataFontSize}" Margin="0,5,0,0"/></StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Operation" VerticalAlignment="Center" Foreground="#AAB4C0"/><ComboBox x:Name="OperationComboBox" Grid.Column="1" SelectionChanged="Input_Changed"/></Grid>
        <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Radius" VerticalAlignment="Center" Foreground="#AAB4C0"/><TextBox x:Name="RadiusTextBox" Grid.Column="1" Text="1" TextChanged="Input_TextChanged"/><TextBlock Text="Iterations" Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#AAB4C0"/><TextBox x:Name="IterationsTextBox" Grid.Column="3" Text="1" TextChanged="Input_TextChanged"/></Grid>
        <Grid Grid.Row="3" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><TextBlock Text="Strength" VerticalAlignment="Center" Foreground="#AAB4C0"/><Slider x:Name="StrengthSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="1" TickFrequency="0.1" ValueChanged="Input_ValueChanged"/><TextBlock x:Name="StrengthText" Grid.Column="2" Text="100%" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#60A5FA"/></Grid>
        <Border Grid.Row="4" Background="#161C25" BorderBrush="#2B3441" BorderThickness="1" Padding="14">
            <StackPanel><TextBlock Text="LIVE ANALYSIS PREVIEW" Foreground="#73737C" FontSize="{StaticResource CaptionFontSize}"/><TextBlock x:Name="BeforeText" Margin="0,8,0,0" Foreground="#AAB4C0" TextWrapping="Wrap"/><TextBlock x:Name="AfterText" Margin="0,7,0,0" Foreground="#60A5FA" TextWrapping="Wrap"/><TextBlock x:Name="ValidationText" Margin="0,8,0,0" Foreground="#6BA1FF" TextWrapping="Wrap"/></StackPanel>
        </Border>
        <Grid Grid.Row="5" Margin="0,16,0,0"><Button Content="Cancel" HorizontalAlignment="Right" Click="CancelButton_Click"/><Button Content="Apply to selection / map" HorizontalAlignment="Left" Background="#4C8DFF" BorderBrush="#6BA1FF" Click="ApplyButton_Click"/></Grid>
    </Grid>
</Window>
