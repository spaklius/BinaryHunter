<Window x:Class="BinaryHunter.UI.MapDefinitionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Map definition" Icon="Assets/BinaryHunter.ico" Width="650" Height="610"
        MinWidth="580" MinHeight="540" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#0D1117" Foreground="#EDF2F7" FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#0D1117"/><Setter Property="Foreground" Value="#EDF2F7"/><Setter Property="BorderBrush" Value="#3B4655"/><Setter Property="Padding" Value="8,6"/></Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource FuturisticComboBox}"/>
        <Style TargetType="Button" BasedOn="{StaticResource FuturisticButton}"><Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="5,0"/></Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="MANUAL MAP DEFINITION" Foreground="#6BA1FF" FontWeight="SemiBold" FontSize="{StaticResource MetadataFontSize}"/>
            <TextBlock Text="Define Z data layout and optional X/Y axis addresses." Foreground="#778391" FontSize="{StaticResource MetadataFontSize}" Margin="0,5,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Name" VerticalAlignment="Center" Foreground="#AAB4C0"/><TextBox x:Name="NameTextBox" Grid.Column="1" Margin="0,0,10,8"/>
                <TextBlock Grid.Column="2" Text="Category" VerticalAlignment="Center" Foreground="#AAB4C0"/><TextBox x:Name="CategoryTextBox" Grid.Column="3" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="1" Text="Z start offset" VerticalAlignment="Center" Foreground="#AAB4C0"/><TextBox x:Name="StartTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,10,8"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Data type" VerticalAlignment="Center" Foreground="#AAB4C0"/><ComboBox x:Name="ValueTypeComboBox" Grid.Row="1" Grid.Column="3" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="2" Text="Width (X)" VerticalAlignment="Center" Foreground="#AAB4C0"/><TextBox x:Name="WidthTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,10,8"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Height (Y)" VerticalAlignment="Center" Foreground="#AAB4C0"/><TextBox x:Name="HeightTextBox" Grid.Row="2" Grid.Column="3" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="3" Text="Byte order" VerticalAlignment="Center" Foreground="#AAB4C0"/><ComboBox x:Name="EndianComboBox" Grid.Row="3" Grid.Column="1" Margin="0,0,10,8" SelectedIndex="0"><ComboBoxItem Content="Intel (little-endian)"/><ComboBoxItem Content="Motorola (big-endian)"/></ComboBox>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="Unit" VerticalAlignment="Center" Foreground="#AAB4C0"/><TextBox x:Name="UnitTextBox" Grid.Row="3" Grid.Column="3" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="4" Text="Factor" VerticalAlignment="Center" Foreground="#AAB4C0"/><TextBox x:Name="FactorTextBox" Grid.Row="4" Grid.Column="1" Margin="0,0,10,8"/>
                <TextBlock Grid.Row="4" Grid.Column="2" Text="Offset" VerticalAlignment="Center" Foreground="#AAB4C0"/><TextBox x:Name="ValueOffsetTextBox" Grid.Row="4" Grid.Column="3" Margin="0,0,0,8"/>
                <Separator Grid.Row="5" Grid.ColumnSpan="4" Margin="0,7,0,13"/>
                <TextBlock Grid.Row="6" Text="X axis offset" VerticalAlignment="Center" Foreground="#60A5FA"/><TextBox x:Name="XAxisTextBox" Grid.Row="6" Grid.Column="1" Margin="0,0,10,8"/>
                <TextBlock Grid.Row="6" Grid.Column="2" Text="X count" VerticalAlignment="Center" Foreground="#AAB4C0"/><TextBox x:Name="XCountTextBox" Grid.Row="6" Grid.Column="3" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="7" Text="Y axis offset" VerticalAlignment="Center" Foreground="#60A5FA"/><TextBox x:Name="YAxisTextBox" Grid.Row="7" Grid.Column="1" Margin="0,0,10,8"/>
                <TextBlock Grid.Row="7" Grid.Column="2" Text="Y count" VerticalAlignment="Center" Foreground="#AAB4C0"/><TextBox x:Name="YCountTextBox" Grid.Row="7" Grid.Column="3" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="8" Text="Comment" VerticalAlignment="Top" Foreground="#AAB4C0"/><TextBox x:Name="CommentTextBox" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                <TextBlock x:Name="ValidationText" Grid.Row="9" Grid.ColumnSpan="4" Foreground="#6BA1FF" Margin="0,12,0,0" TextWrapping="Wrap"/>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="CancelButton_Click"/>
            <Button Content="Save map" Background="#4C8DFF" BorderBrush="#6BA1FF" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
