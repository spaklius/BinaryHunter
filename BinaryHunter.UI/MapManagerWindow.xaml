<Window x:Class="BinaryHunter.UI.MapManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Map manager" Icon="Assets/BinaryHunter.ico" Width="1040" Height="660"
        MinWidth="860" MinHeight="500" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource FuturisticButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="18,12">
            <StackPanel>
                <TextBlock Text="Map and axis manager" Style="{StaticResource WindowTitleTextStyle}"/>
                <TextBlock Text="Create maps, resolve axes and navigate calibration structures."
                           Style="{StaticResource SecondaryTextStyle}" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="190"/>
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="MapsGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                      CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single"
                      MouseDoubleClick="EditButton_Click">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceRaisedBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Padding="9,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource AccentHoverBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ItemCount, StringFormat=' · {0} maps'}"
                                                   Style="{StaticResource MetadataTextStyle}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Map" Binding="{Binding Name}" Width="180"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                    <DataGridTextColumn Header="Z offset" Binding="{Binding StartHex}" Width="115"/>
                    <DataGridTextColumn Header="Size" Binding="{Binding Dimensions}" Width="90"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="105"/>
                    <DataGridTextColumn Header="X axis" Binding="{Binding XAxisLabel}" Width="150"/>
                    <DataGridTextColumn Header="Y axis" Binding="{Binding YAxisLabel}" Width="150"/>
                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="MAP" Style="{StaticResource TechnicalLabelTextStyle}" Margin="2,0,0,7"/>
                        <Button Content="New map" Style="{StaticResource PrimaryActionButton}" Margin="0,0,0,5" Click="AddButton_Click"/>
                        <Button Content="Edit definition" Style="{StaticResource RailButton}" Click="EditButton_Click"/>
                        <Button Content="Delete" Style="{StaticResource RailButton}" Foreground="{StaticResource DangerBrush}" Click="DeleteButton_Click"/>

                        <Separator Margin="0,7"/>
                        <TextBlock Text="IMPORT AND GROUP" Style="{StaticResource TechnicalLabelTextStyle}" Margin="2,0,0,7"/>
                        <Button Content="Import A2L / map pack" Style="{StaticResource RailButton}" Click="ImportDefinitionsButton_Click"/>
                        <Button Content="Export map pack" Style="{StaticResource RailButton}" Click="ExportMapPackButton_Click"/>
                        <Button Content="Auto group" Style="{StaticResource RailButton}" Click="AutoGroupButton_Click"/>

                        <Separator Margin="0,7"/>
                        <TextBlock Text="AXES" Style="{StaticResource TechnicalLabelTextStyle}" Margin="2,0,0,7"/>
                        <Button Content="Find X / Y axes" Style="{StaticResource RailButton}" Click="FindAxesButton_Click"/>
                        <Button Content="Edit X axis" Style="{StaticResource RailButton}" Click="EditXAxisButton_Click"/>
                        <Button Content="Edit Y axis" Style="{StaticResource RailButton}" Click="EditYAxisButton_Click"/>

                        <Separator Margin="0,7"/>
                        <TextBlock Text="NAVIGATE" Style="{StaticResource TechnicalLabelTextStyle}" Margin="2,0,0,7"/>
                        <Button Content="Go to Z data" Style="{StaticResource RailButton}" Click="GoZButton_Click"/>
                        <Button Content="Go to X axis" Style="{StaticResource RailButton}" Click="GoXButton_Click"/>
                        <Button Content="Go to Y axis" Style="{StaticResource RailButton}" Click="GoYButton_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <TextBlock x:Name="StatusText" Style="{StaticResource StatusTextStyle}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="CancelButton_Click"/>
                    <Button Content="Save maps" Style="{StaticResource PrimaryActionButton}"
                            Margin="8,0,0,0" Click="SaveButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
