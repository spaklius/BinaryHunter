<Window x:Class="BinaryHunter.UI.BinaryOverviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project overview" Width="420" Height="680" MinWidth="340" MinHeight="460"
        Background="#0D1117" Foreground="#EDF2F7" FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="PROJECT OVERVIEW" FontSize="{StaticResource PageTitleFontSize}" FontWeight="SemiBold"/>
                <TextBlock x:Name="HeaderText" Margin="0,4,0,0" Foreground="#AAB4C0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button Grid.Column="1" Content="REBUILD" Click="RebuildButton_Click"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,14,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#050507" BorderBrush="#3B4655" BorderThickness="1" Padding="5">
                <Canvas x:Name="OverviewCanvas" Background="#07070A" SizeChanged="OverviewCanvas_SizeChanged"
                        MouseLeftButtonDown="OverviewCanvas_MouseLeftButtonDown"
                        MouseMove="OverviewCanvas_MouseMove" Cursor="Cross" ClipToBounds="True"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="16,2,0,0">
                <TextBlock Text="DATA CLASSIFICATION" FontWeight="SemiBold" Foreground="#DCE3EB"/>
                <StackPanel Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,9"><Border Width="18" Height="10" Background="#27272A"/><TextBlock Text="Empty / padding (00, FF)" Margin="9,-2,0,0" Foreground="#AAB4C0"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,9"><Border Width="18" Height="10" Background="#0E7490"/><TextBlock Text="ASCII / identifiers" Margin="9,-2,0,0" Foreground="#AAB4C0"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,9"><Border Width="18" Height="10" Background="#334155"/><TextBlock Text="Program / binary data" Margin="9,-2,0,0" Foreground="#AAB4C0"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,9"><Border Width="18" Height="10" Background="#CA8A04"/><TextBlock Text="Saved map range" Margin="9,-2,0,0" Foreground="#AAB4C0"/></StackPanel>
                    <StackPanel Orientation="Horizontal"><Border Width="18" Height="10" Background="#4C8DFF"/><TextBlock Text="Difference to reference" Margin="9,-2,0,0" Foreground="#AAB4C0"/></StackPanel>
                </StackPanel>
                <Border Margin="0,22,0,0" Background="#121216" BorderBrush="#303038" BorderThickness="1" Padding="11">
                    <StackPanel>
                        <TextBlock Text="CURRENT REGION" Foreground="#71717A" FontSize="{StaticResource CaptionFontSize}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="RegionText" Margin="0,6,0,0" Foreground="#EDF2F7" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <TextBlock Margin="0,18,0,0" Text="Click or drag on the overview to navigate. Red areas take priority over map and data classification." Foreground="#71717A" TextWrapping="Wrap" FontSize="{StaticResource MetadataFontSize}"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Foreground="#AAB4C0" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="CLOSE" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
