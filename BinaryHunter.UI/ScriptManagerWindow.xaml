<Window x:Class="BinaryHunter.UI.ScriptManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scripts" Icon="Assets/BinaryHunter.ico" Width="1000" Height="700"
        MinWidth="780" MinHeight="540" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#0D1117" Foreground="#EDF2F7" FontFamily="{StaticResource UiFont}">
    <Window.Resources><Style TargetType="Button" BasedOn="{StaticResource FuturisticButton}"><Setter Property="Padding" Value="13,7"/><Setter Property="Margin" Value="4,0"/></Style></Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><StackPanel><TextBlock Text="SCRIPT AUTOMATION" Foreground="#60A5FA" FontWeight="SemiBold" FontSize="{StaticResource MetadataFontSize}"/><TextBlock Text="Sandboxed commands are evaluated against a working copy. Review the log before applying changes." Foreground="#778391" FontSize="{StaticResource MetadataFontSize}" Margin="0,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="OPEN" Click="OpenButton_Click"/><Button Content="SAVE" Click="SaveButton_Click"/><Button Content="TEMPLATE" Click="TemplateButton_Click"/></StackPanel></Grid>
        <TextBox x:Name="ScriptTextBox" Grid.Row="1" Margin="0,13,0,8" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="{StaticResource MonospaceFont}" FontSize="{StaticResource MetadataFontSize}" Background="#0B0B0D" Foreground="#EDF2F7" BorderBrush="#2B3441" Padding="10"/>
        <TextBox x:Name="LogTextBox" Grid.Row="2" Margin="0,0,0,8" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonospaceFont}" FontSize="{StaticResource MetadataFontSize}" Background="#10151D" Foreground="#AAB4C0" BorderBrush="#2B3441" Padding="10"/>
        <Grid Grid.Row="3"><TextBlock x:Name="StatusText" Foreground="#AAB4C0" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="PREVIEW" Click="PreviewButton_Click"/><Button x:Name="ApplyButton" Content="APPLY PREVIEW" IsEnabled="False" Background="#4C8DFF" BorderBrush="#6BA1FF" Click="ApplyButton_Click"/><Button Content="CLOSE" Click="CloseButton_Click"/></StackPanel></Grid>
    </Grid>
</Window>
