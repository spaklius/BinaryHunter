<Window x:Class="BinaryHunter.UI.ChecksumManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Checksums" Icon="Assets/BinaryHunter.ico" Width="1080" Height="640"
        MinWidth="860" MinHeight="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#0D1117" Foreground="#EDF2F7" FontFamily="{StaticResource UiFont}">
    <Window.Resources><Style TargetType="Button" BasedOn="{StaticResource FuturisticButton}"><Setter Property="Padding" Value="13,7"/><Setter Property="Margin" Value="4,0"/></Style></Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12"><TextBlock Text="CHECKSUM BLOCKS" Foreground="#60A5FA" FontWeight="SemiBold" FontSize="{StaticResource MetadataFontSize}"/><TextBlock Text="Manage checked ranges, stored values and correction rules. Changes are applied to a working copy until Save is pressed." Foreground="#778391" FontSize="{StaticResource MetadataFontSize}" Margin="0,5,0,0"/></StackPanel>
        <DataGrid x:Name="BlocksGrid" Grid.Row="1" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False"
                  SelectionMode="Single" Background="#10151D" Foreground="#EDF2F7" BorderBrush="#2B3441" RowBackground="#10151D" AlternatingRowBackground="#1B222D" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="NAME" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="165"/>
                <DataGridTextColumn Header="ALGORITHM" Binding="{Binding Algorithm, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                <DataGridTextColumn Header="RANGE START" Binding="{Binding RangeStartText, UpdateSourceTrigger=PropertyChanged}" Width="115"/>
                <DataGridTextColumn Header="LENGTH" Binding="{Binding RangeLengthText, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                <DataGridTextColumn Header="STORE AT" Binding="{Binding StoreOffsetText, UpdateSourceTrigger=PropertyChanged}" Width="115"/>
                <DataGridTextColumn Header="BYTES" Binding="{Binding StoredByteCount, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
                <DataGridCheckBoxColumn Header="INTEL" Binding="{Binding LittleEndian}" Width="60"/>
                <DataGridCheckBoxColumn Header="AUTO" Binding="{Binding AutomaticCorrection}" Width="60"/>
                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <WrapPanel Grid.Row="2" Margin="0,13,0,0">
            <Button Content="ADD MANUAL" Click="AddButton_Click"/><Button Content="DELETE" Click="DeleteButton_Click"/>
            <Separator Width="12" Background="Transparent"/>
            <Button Content="SEARCH PLUGINS" Background="#172A49" BorderBrush="#4C8DFF" Click="SearchPluginsButton_Click"/>
            <Button Content="APPLY SELECTED" Click="ApplySelectedButton_Click"/><Button Content="APPLY ALL" Click="ApplyAllButton_Click"/>
            <Button Content="PLUGIN INFO" Click="PluginInfoButton_Click"/>
        </WrapPanel>
        <Grid Grid.Row="3" Margin="0,14,0,0"><TextBlock x:Name="StatusText" Foreground="#AAB4C0" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="CANCEL" Click="CancelButton_Click"/><Button Content="SAVE" Background="#4C8DFF" BorderBrush="#6BA1FF" Click="SaveButton_Click"/></StackPanel></Grid>
    </Grid>
</Window>
